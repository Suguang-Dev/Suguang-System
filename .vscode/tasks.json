{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build C++23",
            "type": "shell",
            "command": "F:/gcc/MSYS2_GCC_16.2.0/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++23",
                "-fmodules-ts",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}